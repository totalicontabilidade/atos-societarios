# arrastado para esta pasta por engano, o Git o ignora e ele não vai
# parar num repositório público. Isto é uma trava de segurança.
*.pdf
*.docx
*.doc
*.odt
*.rtf
*.xlsx
*.xls
*.csv
*.zip

# Rascunhos / dados de trabalho
/reference/
/temp/
/tmp/
/casos/
*.local
*.bak

# Pastas de trabalho que moram AO LADO do site, dentro desta mesma pasta:
# modelos-jucese (os modelos oficiais da Junta) e .claude (as permissões locais
# da máquina). Nenhuma das duas pode ir para o repositório, que é público.
/modelos-jucese/
/.claude/

# Sistema operacional / editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*~

# Dependência só da bateria no GitHub (o sistema não usa)
/node_modules/

# Pesquisa e relatórios de planejamento (trabalho interno, não vão para o site público)
/research_notes/
/reports/

# Cloud Functions (robô do WhatsApp): dependências e logs do deploy ficam de fora
/functions/node_modules/
